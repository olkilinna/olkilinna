---
const { slug, title, date, arrange, hero } = Astro.props
---

<a href={`/blogi/${slug}`} class="group block overflow-hidden w-full h-full">
  <div
    class="bg-cover bg-center w-full h-full flex flex-col items-center justify-center text-white transition-transform duration-200 group-hover:scale-105"
    style={`background-image: url(${hero})`}
  >
    <p class="bg-black text-white text-sm font-semibold px-1 uppercase">
      {date}
    </p>
    <h4 class="bg-white text-black mx-2 px-2 block text-md font-bold mt-1.5 text-center">
      <span>{arrange}</span>. {title}
    </h4>
  </div>
</a>
