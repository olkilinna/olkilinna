---
import Markdown from './Markdown.astro'

const { heading, content, color = '' } = Astro.props

const isColorCode = color.startsWith('#') || color.startsWith('rgb')

// Summary background
const summaryStyle = isColorCode ? { backgroundColor: color } : undefined
const summaryClass = !isColorCode ? color : ''

// Div border
const divBorderStyle = isColorCode ? { borderColor: color } : undefined
const divBorderClass = !isColorCode ? color : ''
---

<li class="pros-n-cons-card h-full not-prose">
  <div class="accordion w-full">
    <div
      class={`accordion-header w-full text-white px-4 py-2 flex justify-between items-center cursor-pointer ${summaryClass}`}
      style={summaryStyle}
    >
      <h3 class="not-prose text-xl font-heading font-medium">
        {heading}
      </h3>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 arrow block transition-transform duration-200 rotate-90 md:hidden"
        fill="none"
        aria-hidden="true"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </div>

    <div
      class={`content hidden py-4 px-5 not-prose prose-blockquote:ml-0 border-2 ${divBorderClass}`}
      style={divBorderStyle}
    >
      <Markdown content={content} class="mb-4 text-black" />
    </div>
  </div>
</li>
