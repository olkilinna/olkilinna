---
import { createReader } from '@keystatic/core/reader'
import keystaticConfig from '../../keystatic.config'
import PostCard from './PostCard.astro'

const { slugs } = Astro.props

const reader = createReader(process.cwd(), keystaticConfig)
const allPosts = await reader.collections.posts.all()

// Create a map of slug -> post for quick lookup
const postMap = new Map(allPosts.map((post) => [post.slug, post]))

// Filter and get the actual post data for the provided slugs
const related = slugs.map((slug) => postMap.get(slug)).filter(Boolean) // Remove any undefined posts if a slug doesn't exist
---

{
  related.length > 0 && (
    <div class="not-prose px-10 py-5 bg-[#f4f4f5] text-black mt-8">
      <h4 class="font-bold text-lg mb-3">Tähän liittyviä blogin artikkeleita:</h4>
      <ul class="list-none space-y-1">
        {related.map((post) => (
          <li class="underline hover:text-link-hover duration-200">
            <a href={`/blogi/${post.slug}`}>
              <p>
                <span>{post.entry.arrange}. </span>
                {typeof post.entry.title === 'string' ? post.entry.title : post.entry.title?.name}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
