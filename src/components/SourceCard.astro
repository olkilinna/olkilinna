---
import Markdown from './Markdown.astro'

const { linkType, heading, link, bgColor = '', image, content } = Astro.props

// Handle image as either a string (URL) or an object with .src
const imgUrl = typeof image === 'string' ? image : image?.src

// Handle legacy values, empty values, and new free-form inputs
let finalBgColor = bgColor.trim();
if (finalBgColor === 'default' || finalBgColor === '') {
  finalBgColor = 'bg-black';
} else if (finalBgColor === 'muted') {
  finalBgColor = 'bg-gray-50';
} else if (finalBgColor === 'accent') {
  finalBgColor = 'bg-amber-50';
}

// Handle bgColor as either a hex/rgb code (inline style) or a Tailwind class
const isColorCode = finalBgColor.startsWith('#') || finalBgColor.startsWith('rgb')
const bgStyle = isColorCode ? { backgroundColor: finalBgColor } : undefined
const bgClass = !isColorCode ? finalBgColor : ''
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  class={`not-prose h-60 ${bgClass} overflow-hidden relative group shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200 text-white flex flex-col justify-end`}
  style={bgStyle}
>
  {imgUrl && <img src={imgUrl} alt={heading} class="w-full z-0 absolute inset-0 object-cover" />}

  <div class="relative z-10 px-6 pb-3 pt-3 bg-black/80">
    <p class="text-sm font-normal uppercase tracking-wider mb-1">{linkType}</p>
    <h3
      class="text-md leading-tight font-semibold group-hover:text-link-hover transition-colors mb-2"
    >
      {heading}
    </h3>

    <div class="">
      <Markdown content={content} class="[&_p]:text-white [&_p]:text-sm [&_p]:mt-0" />
    </div>
  </div>
</a>
