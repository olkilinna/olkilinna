---
import Image from 'astro/components/Image.astro'
import { createReader } from '@keystatic/core/reader'
import keystaticConfig from '../../keystatic.config'

const reader = createReader(process.cwd(), keystaticConfig)
const posts = await reader.collections.posts.all()
const postsByYear = new Map<string | number, typeof posts>()

for (const post of posts) {
  const year = post.entry.year
  if (!postsByYear.has(year)) {
    postsByYear.set(year, [])
  }
  postsByYear.get(year)!.push(post)
}

const sortedYears = Array.from(postsByYear.keys()).sort((a, b) => Number(b) - Number(a))
---

<header
  id="nav-header"
  class="fixed top-0 left-0 right-0 z-50 bg-white shadow-md lg:hidden flex items-center justify-between px-4 py-2"
>
  <a href="/"><Image src="/logo.svg" alt="Olkilinna" width="115" height="40" /></a>
  <button id="burger-btn" class="p-2" aria-label="Toggle menu">
    <svg
      id="burger-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="currentColor"
      viewBox="0 0 256 256"
    >
      <path
        d="M40,88a12,12,0,0,1,12-12H204a12,12,0,0,1,0,24H52A12,12,0,0,1,40,88Zm164,32H52a12,12,0,0,0,0,24H204a12,12,0,0,0,0-24Z"
      ></path>
    </svg>
    <svg
      id="close-icon"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="currentColor"
      viewBox="0 0 256 256"
      class="hidden"
    >
      <path
        d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"
      ></path>
    </svg>
  </button>
</header>

<div
  id="mobile-menu"
  class="lg:hidden fixed top-0 left-0 right-0 bottom-0 z-40 bg-white pt-14 overflow-y-auto hidden"
>
  <nav class="p-6 font-medium">
    <div class="flex flex-col gap-3 w-full">
      <ul class="flex flex-col w-full gap-3">
        <li><a href="/" class="block hover:text-yellow-600 duration-200">Etusivu</a></li>
        <li>
          <a href="/talomme-resepti" class="block hover:text-yellow-600 duration-200"
            >Talomme resepti</a
          >
        </li>
        <li>
          <a href="/olkielementit" class="block hover:text-yellow-600 duration-200">Olkielementit</a
          >
        </li>
        <li>
          <a href="/tietolahteita" class="block hover:text-yellow-600 duration-200">Tietolähteitä</a
          >
        </li>
      </ul>
      <a href="/blogi" class="block hover:text-yellow-600 duration-200">Blogi</a>
      <div class="border-l border-gray-400 pl-5 ml-1">
        {
          sortedYears.map((year) => {
            const yearPosts = postsByYear
              .get(year)!
              .sort((a, b) => Number(b.entry.arrange) - Number(a.entry.arrange))
            return (
              <div class="mb-3">
                <button
                  data-year-toggle={year}
                  class="cursor-pointer w-full flex justify-between gap-2 mb-2"
                >
                  <p class="font-bold">{year}</p>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    aria-hidden="true"
                    width="15"
                    height="15"
                    fill="currentColor"
                    viewBox="0 0 256 256"
                    data-year-chevron={year}
                    class="transition-transform duration-200"
                  >
                    <path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z" />
                  </svg>
                </button>
                <ul data-year-content={year} class="flex-col font-normal hidden">
                  {yearPosts.map((post) => (
                    <li class="border-l border-gray-300 hover:border-gray-500 duration-200 pl-5 ml-1 py-2">
                      <a href={`/blogi/${post.slug}`}>
                        <p>
                          <span class="p-1 rounded-sm bg-gray-200 mr-2">{post.entry.arrange}</span>
                        {post.entry.title}
                        </p>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          })
        }
      </div>
      <a href="#footer" class="block hover:text-yellow-600 duration-200 mt-3">Yhteystiedot</a>
      <a href="/haku" class="hover:text-yellow-600 duration-200 flex flex-row gap-2 items-center"
        ><svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          fill="currentColor"
          aria-hidden="true"
          viewBox="0 0 256 256"
          ><path
            d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"
          ></path></svg
        >Sivustohaku</a
      >
    </div>
  </nav>
</div>

<nav class="hidden lg:block h-screen w-full max-w-90 p-10 font-medium sticky top-0 overflow-y-auto">
  <div class="flex flex-col gap-3 w-full">
    <a href="/" class="mb-5"><Image src="/logo.svg" alt="Olkilinna" width="170" height="50" /></a>
    <ul class="flex flex-col w-full gap-3">
      <li><a href="/" class="block hover:text-yellow-600 duration-200">Etusivu</a></li>
      <li>
        <a href="/talomme-resepti" class="block hover:text-yellow-600 duration-200"
          >Talomme resepti</a
        >
      </li>
      <li>
        <a href="/olkielementit" class="block hover:text-yellow-600 duration-200">Olkielementit</a>
      </li>
      <li>
        <a href="/tietolahteita" class="block hover:text-yellow-600 duration-200">Tietolähteitä</a>
      </li>
    </ul>
    <a href="/blogi" class="block hover:text-yellow-600 duration-200">Blogi</a>
    <div class="border-l border-gray-400 pl-5 ml-1">
      {
        sortedYears.map((year) => {
          const yearPosts = postsByYear
            .get(year)!
            .sort((a, b) => Number(b.entry.arrange) - Number(a.entry.arrange))
          return (
            <div class="mb-3">
              <button
                data-year-toggle={year}
                class="cursor-pointer w-full flex justify-between gap-2 mb-2 hover:text-yellow-600 duration-200"
              >
                <p class="font-bold">{year}</p>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                  width="15"
                  height="15"
                  fill="currentColor"
                  viewBox="0 0 256 256"
                  data-year-chevron={year}
                  class="transition-transform duration-200"
                >
                  <path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z" />
                </svg>
              </button>
              <ul data-year-content={year} class="flex-col font-normal hidden">
                {yearPosts.map((post) => (
                  <li class="border-l border-gray-300 hover:border-gray-500 duration-200 pl-5 ml-1 py-2">
                    <a href={`/blogi/${post.slug}`}>
                      <p>
                        <span class="p-1 rounded-sm bg-gray-200 mr-2">{post.entry.arrange}</span>
                        {post.entry.title}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        })
      }
    </div>
    <a href="#footer" class="block hover:text-yellow-600 duration-200 mt-3">Yhteystiedot</a>
    <a href="/haku" class="flex flex-row items-center gap-2 hover:text-yellow-600 duration-200"
      ><svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        fill="currentColor"
        aria-hidden="true"
        viewBox="0 0 256 256"
        ><path
          d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"
        ></path></svg
      >Sivustohaku</a
    >
  </div>
</nav>

<script is:inline>
  const burgerBtn = document.getElementById('burger-btn')
  const burgerIcon = document.getElementById('burger-icon')
  const closeIcon = document.getElementById('close-icon')
  const mobileMenu = document.getElementById('mobile-menu')

  if (!burgerBtn || !burgerIcon || !closeIcon || !mobileMenu || !document.body) {
    throw new Error('Required DOM elements not found')
  }

  function openMenu() {
    mobileMenu.classList.remove('hidden')
    document.body.style.overflow = 'hidden'
    burgerIcon.classList.add('hidden')
    closeIcon.classList.remove('hidden')
  }

  function closeMenu() {
    mobileMenu.classList.add('hidden')
    document.body.style.overflow = ''
    burgerIcon.classList.remove('hidden')
    closeIcon.classList.add('hidden')
  }

  burgerBtn.addEventListener('click', () => {
    if (mobileMenu.classList.contains('hidden')) {
      openMenu()
    } else {
      closeMenu()
    }
  })

  document.querySelectorAll('[data-year-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling
      const chevron = btn.querySelector('[data-year-chevron]')

      if (content && chevron) {
        if (content.classList.contains('hidden')) {
          content.classList.remove('hidden')
          content.classList.add('flex')
          chevron.style.transform = 'rotate(-90deg)'
          chevron.style.transformOrigin = '50% 50%'
        } else {
          content.classList.add('hidden')
          content.classList.remove('flex')
          chevron.style.transform = ''
          chevron.style.transformOrigin = ''
        }
      }
    })
  })

  document.addEventListener(
    'click',
    (e) => {
      const link = e.target.closest('a[href="#footer"]')
      if (link) {
        e.preventDefault()
        e.stopImmediatePropagation()
        const footer = document.getElementById('footer')
        if (footer) {
          const navEl = document.querySelector('#nav-header ~ #mobile-menu, nav.h-screen')
          if (navEl) {
            navEl.scrollTop = 0
          }
          const top = footer.getBoundingClientRect().top + window.scrollY
          window.scrollTo({ top, behavior: 'instant' })
        }
        if (!mobileMenu.classList.contains('hidden')) {
          closeMenu()
        }
      }
    },
    true
  )
</script>
