---
import Markdown from './Markdown.astro'

const { title, content } = Astro.props
---

<details class="group bg-light-grey my-6 text-black">
  <summary
    class="not-prose flex font-heading justify-between items-center cursor-pointer py-2 px-6 list-none hover:bg-gray-200 duration-200 border-2 border-gray-200"
  >
    <h3 class="text-[1.4rem] font-medium leading-tight">{title}</h3>
    <span class="transition-transform duration-200 group-open:rotate-180">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5 text-gray-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </span>
  </summary>
  <div class="px-6 py-4 text-gray-700 bg-white border-2 border-t-0 border-gray-200 w-full">
    <Markdown content={content} class="max-w-none" />
  </div>
</details>
