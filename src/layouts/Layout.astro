---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

const { title = 'Olkilinna', heroImage } = Astro.props
const siteUrl = 'https://olkilinna.fi' // Replace with your actual domain
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/olkilinna-logo-favicon.png" />
    <link rel="apple-touch-icon" href="/olkilinna-logo-web-clip.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    {heroImage && (
      <>
        <!-- For Pagefind site search -->
        <meta data-pagefind-default-meta="image[content]" content={heroImage} />
        <!-- For Google and Social Media -->
        <meta property="og:image" content={`${siteUrl}${heroImage}`} />
        <meta name="twitter:image" content={`${siteUrl}${heroImage}`} />
      </>
    )}
  </head>
  <body class="font-main font-normal text-[1rem] bg-white">
    <div class="w-full h-full flex flex-row">
      <Nav />
      <div class="flex flex-col w-full">
        <slot />
      </div>
    </div>
    <Footer />
    
    <!-- 100% privacy-first analytics -->
<script data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>

  </body>
  <script is:inline>
    function initAccordions() {
      const isDesktop = window.innerWidth >= 768

      document.querySelectorAll('.accordion').forEach((accordion) => {
        const header = accordion.querySelector('.accordion-header')
        const content = accordion.querySelector('.content')
        const arrow = accordion.querySelector('.arrow')

        if (!header || !content) return

        if (isDesktop) {
          content.classList.remove('hidden')
          content.classList.add('block')
          if (arrow) arrow.style.transform = 'rotate(0deg)'
        } else {
          content.classList.add('hidden')
          content.classList.remove('block')
          if (arrow) arrow.style.transform = 'rotate(0deg)'
        }

        if (!header.dataset.accordionBound) {
          header.dataset.accordionBound = 'true'
          header.addEventListener('click', () => {
            if (window.innerWidth >= 768) return
            const isHidden = content.classList.contains('hidden')
            if (isHidden) {
              content.classList.remove('hidden')
              content.classList.add('block')
              if (arrow) arrow.style.transform = 'rotate(-90deg)'
            } else {
              content.classList.add('hidden')
              content.classList.remove('block')
              if (arrow) arrow.style.transform = 'rotate(0deg)'
            }
          })
        }
      })
    }

    let wasDesktop = window.innerWidth >= 768

    function handleResize() {
      const isDesktop = window.innerWidth >= 768
      if (isDesktop === wasDesktop) return
      wasDesktop = isDesktop
      initAccordions()
    }

    initAccordions()
    window.addEventListener('resize', handleResize)
  </script>
</html>
