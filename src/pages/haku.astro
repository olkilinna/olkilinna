---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Sivustohaku | Olkilinna">
  <main class="w-full max-w-4xl mx-auto px-6 py-12 lg:mt-0 mt-14">
    <h1 class="text-3xl font-bold mb-3">Sivustohaku</h1>
    <p>Hae sivustolta kirjoittamalla hakusana.</p>
    <div id="search" class="w-full max-w-2xl mt-8"></div>
  </main>
</Layout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" type="text/javascript"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: true,
      translations: {
        placeholder: 'Hae sivustolta...',
      },
    })

    /* SIMPLE ANALYTICS  */
    // Configuration
    const MIN_CHARACTERS = 3
    const DEBOUNCE_DELAY = 3000 // 3 second
    let searchTimer

    const searchInput = document.querySelector('#search input[type="text"]')

    if (searchInput) {
      // 1. Handle typing (Debounced)
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim().toLowerCase()

        clearTimeout(searchTimer)

        if (query.length >= MIN_CHARACTERS) {
          searchTimer = setTimeout(() => {
            sendSearchToAnalytics(query)
          }, DEBOUNCE_DELAY)
        }
      })

      // 2. Handle "Enter" key (Immediate)
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const query = e.target.value.trim().toLowerCase()
          if (query.length >= MIN_CHARACTERS) {
            clearTimeout(searchTimer) // Prevent double-firing with the debounce
            sendSearchToAnalytics(query)
          }
        }
      })
    }

    // 3. Simple Analytics Event Function
    function sendSearchToAnalytics(query) {
      if (window.sa_event) {
        // We use a custom attribute to ensure we don't track the same word twice in a row
        if (window.lastSearchQuery === query) return

        //console.log(`Simple Analytics: Tracking search for "${query}"`);
        sa_event('click_search', { search_query: `${query}` })

        window.lastSearchQuery = query
      }
    }
  })
</script>

<style is:global>
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #ca8a04;
    --pagefind-ui-text: #000000;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #d1d5db;
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-font: inherit;
  }

  #search .pagefind-ui__search-input {
    padding: 0.75rem 1rem 0.75rem 2.5rem; /* Extra left padding for the magnifying glass icon */
    font-size: 1rem;
  }

  #search .pagefind-ui__search-input:focus {
    outline: 2px solid #ca8a04;
    outline-offset: 2px;
  }

  #search .pagefind-ui__result {
    padding: 1rem 0;
    border-bottom: 0px solid #e5e7eb;
  }

  #search .pagefind-ui__result:last-child {
    border-bottom: none;
  }

  #search .pagefind-ui__result-title,
  #search .pagefind-ui__result-link {
    font-size: 1.25rem;
    font-weight: 600;
    font-family: 'League Spartan', sans-serif;
    color: #000000;
    text-decoration: none;
  }

  #search .pagefind-ui__result-title:hover {
    color: #ca8a04;
  }

  #search .pagefind-ui__result-excerpt {
    font-size: 0.875rem;
    color: #4b5563;
    margin-top: 0.25rem;
  }

  /* Override the bright default highlight color */
  #search .pagefind-ui mark,
  #search .pagefind-ui__result-excerpt mark {
    background-color: #ffd57c; /* Softer, lighter yellow */
    color: #000000; /* Dark gray text for readability */
    padding: 0.1em 0.2em;
    border-radius: 0.125rem;
    font-weight: 600;
  }

  /* Style the ::before marker/icon on result links */
  #search .pagefind-ui__result-link::before,
  #search .pagefind-ui__result-title::before {
    color: #000000; /* Match your site's primary yellow */
    margin-right: 0.25rem;
    position: absolute;
    top: -10;
    right: calc(100% + 0.3rem);

    /* If you want to hide the marker completely, uncomment the line below: */
    /* display: none; */
  }
</style>
